<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ARTIFACT ONLY. NOT auto-installed. Daily retention sweep for
  execution_feasibility_evidence (zeus_trades.db) -- companion to
  com.zeus.decision-log-retention.plist and
  com.zeus.executable-market-snapshots-retention.plist. Same rationale
  (independent of the main Python scheduler) and same gating law (default
  OFF; installing this plist IS the operator's explicit enable step, only
  after a manual dry-run + --apply run has been verified).

  scripts/migrations/202608_execution_feasibility_evidence_retention.py is
  dry-run by default; this job explicitly passes --apply with the script's
  own default --keep-days (30, floor 7) and default chunk size. No
  append-only trigger and no external FK anchor exist for this table (see
  the migration's module docstring consumer-window audit) -- straightforward
  time-window DELETE.

  DELETE alone does not shrink the on-disk file (auto_vacuum=0 on the live
  trade DB as of 2026-08-25) -- see the decision-log-retention plist's
  comment and the migration script's VACUUM note for the full path.

  ZEUS_REPO_PLACEHOLDER is substituted with the repo's absolute path at
  install time via scripts/install_launchd_plist.py.

  INSTALL (operator, run from the repo root, ONLY after verifying a manual
  --apply run):
    python3 scripts/install_launchd_plist.py deploy/launchd/com.zeus.execution-feasibility-evidence-retention.plist
    launchctl bootout gui/$(id -u)/com.zeus.execution-feasibility-evidence-retention 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zeus.execution-feasibility-evidence-retention.plist
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.zeus.execution-feasibility-evidence-retention</string>
	<key>ProgramArguments</key>
	<array>
		<string>ZEUS_REPO_PLACEHOLDER/.venv/bin/python3</string>
		<string>ZEUS_REPO_PLACEHOLDER/scripts/migrations/202608_execution_feasibility_evidence_retention.py</string>
		<string>--apply</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>ZEUS_REPO_PLACEHOLDER/logs/execution_feasibility_evidence_retention.log</string>
	<key>StandardOutPath</key>
	<string>ZEUS_REPO_PLACEHOLDER/logs/execution_feasibility_evidence_retention.log</string>
	<key>StartInterval</key>
	<integer>86400</integer>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>ZEUS_REPO_PLACEHOLDER</string>
</dict>
</plist>
