<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ARTIFACT ONLY. Risk-guard money-path sidecar (src.riskguard.riskguard).

  ZEUS_REPO_PLACEHOLDER is substituted with the repo's absolute path at
  install time (same convention as bindings/zeus/launchd_plist.plist) —
  this file never names an operator's machine.

  INSTALL (operator, run from the repo root):
    sed "s#ZEUS_REPO_PLACEHOLDER#$(pwd)#g" deploy/launchd/com.zeus.riskguard-live.plist \
      > ~/Library/LaunchAgents/com.zeus.riskguard-live.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zeus.riskguard-live.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.zeus.riskguard-live</string>
	<key>ProgramArguments</key>
	<array>
		<string>ZEUS_REPO_PLACEHOLDER/.venv/bin/python</string>
		<string>-m</string>
		<string>src.riskguard.riskguard</string>
	</array>
	<key>WorkingDirectory</key>
	<string>ZEUS_REPO_PLACEHOLDER</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONPATH</key>
		<string>ZEUS_REPO_PLACEHOLDER</string>
		<key>PYTHONSAFEPATH</key>
		<string>1</string>
		<key>ZEUS_MODE</key>
		<string>live</string>
		<key>ZEUS_PRIMARY_ROOT</key>
		<string>ZEUS_REPO_PLACEHOLDER</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>ZEUS_REPO_PLACEHOLDER/logs/riskguard-live.log</string>
	<key>StandardErrorPath</key>
	<string>ZEUS_REPO_PLACEHOLDER/logs/riskguard-live.err</string>
</dict>
</plist>
